class Solution:
    def reverse(self, x):
        INT_MIN = -2147483648
        INT_MAX = 2147483647
        sign = -1 if x < 0 else 1
        x = abs(x)
        res = 0
        while x != 0:
            d = x % 10
            x //= 10
            if res > INT_MAX // 10:
                return 0
            if res == INT_MAX // 10 and d > INT_MAX % 10:
                return 0
            res = res * 10 + d
        res *= sign
        if res < INT_MIN or res > INT_MAX:
            return 0
        return res
